# =============================================================================
# AI Helper — configuration
#
# Copy to .env and fill in. NEVER commit .env.
#
#   cp .env.example .env
#   openssl rand -hex 32                     # -> AUTH_SECRET
#   python -m app.cli hash-password          # -> ADMIN_PASSWORD_HASH
#
# The defaults below are the safe ones: paid providers OFF, budgets finite,
# RESTRICTED data unable to leave the system. Every one of those is a decision,
# not an accident — change them deliberately.
# =============================================================================

# --- application -------------------------------------------------------------
APP_NAME=AI Helper
ENVIRONMENT=development          # development | test | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                  # json | console   (logs go to stderr)

# --- services ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://aihelper:CHANGE_ME@postgres:5432/aihelper
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_ENABLED=true
OLLAMA_URL=http://ollama:11434
OLLAMA_ENABLED=true
N8N_URL=http://n8n:5678

# --- local models ------------------------------------------------------------
# Pull these before first use:  docker compose exec ollama ollama pull llama3.2:3b
DEFAULT_LOCAL_MODEL=llama3.2:3b
SMALL_LOCAL_MODEL=llama3.2:1b
STRONG_LOCAL_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
LOCAL_TIMEOUT_SECONDS=180   # a 3B model on CPU with a full context can need over a minute; match the proxy timeout
# Measured on the production box 2026-09-16: qwen2.5:7b runs at 5.35 tok/s and a
# real request carries ~2,320 input tokens (~11 s of prompt eval). Against a 180 s
# budget that leaves ~900 tokens warm, ~740 cold. 1024 was above both, so a long
# answer could not finish. Raise this only with a measurement that says it fits.
LOCAL_MAX_TOKENS=600
LOCAL_CONTEXT_CHARS=4500   # evidence budget for the local prompt; the biggest CPU latency knob

# --- paid providers ----------------------------------------------------------
# OFF by default, and enabling one is not enough — it also needs a key.
# Everything keeps working with both of these false; the system simply cannot
# escalate, and says so in the escalation_blocked_reason of each response.
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override to reach an OpenAI-compatible endpoint or an egress proxy.
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

PAID_PROVIDER_ORDER=anthropic,openai
PAID_TIMEOUT_SECONDS=90
PAID_MAX_TOKENS=2048

# --- cost protection (mandatory) ---------------------------------------------
# When a budget is reached, paid providers stop and the system keeps running
# locally. There is no override path.
AI_DAILY_API_BUDGET=5.00
AI_MONTHLY_API_BUDGET=50.00
AI_MAX_COST_PER_REQUEST=0.50
AI_MAX_INPUT_TOKENS_PER_REQUEST=24000
# Task types that may never escalate, comma separated. e.g. document_qa,extraction
PAID_TASK_DENYLIST=

# --- escalation --------------------------------------------------------------
ESCALATION_ENABLED=true
CONFIDENCE_THRESHOLD=0.62
# Honour a caller's "premium: true". Off by default: it is a way to spend money
# without a validation failure behind it.
ALLOW_USER_REQUESTED_PREMIUM=false

# --- privacy -----------------------------------------------------------------
# RESTRICTED may never appear here; the application refuses to start if it does.
EXTERNAL_ALLOWED_CLASSIFICATIONS=PUBLIC,INTERNAL
REDACT_BEFORE_ESCALATION=true

# --- security ----------------------------------------------------------------
# Signs the admin session cookie. With ENVIRONMENT=production the application
# REFUSES TO START unless this is set to something at least 32 characters long
# that is not the published default: a placeholder here means anyone who has
# read the repository can forge an admin session.
AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_TTL_MINUTES=720
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20
MAX_REQUEST_CHARS=32000

# --- memory and retrieval ----------------------------------------------------
# Two scales: a real embedding model and the lexical fallback score differently.
# See app/core/config.py — do not copy one pair over the other.
MEMORY_SIMILARITY_THRESHOLD=0.72
SOLUTION_REUSE_THRESHOLD=0.80
LEXICAL_MEMORY_SIMILARITY_THRESHOLD=0.15
LEXICAL_SOLUTION_REUSE_THRESHOLD=0.55
MEMORY_TOP_K=5
KNOWLEDGE_TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=150
MAX_UPLOAD_BYTES=20971520

# --- learning ----------------------------------------------------------------
# AUTO_PROMOTE=true lets a validated, locally-reproducible answer become
# reusable knowledge without a human. Both gates still apply. Set false to
# review every candidate in /admin/solutions first.
AUTO_PROMOTE=false
PROMOTION_REQUIRES_REPRODUCTION=true
PROMOTION_MIN_CONFIDENCE=0.70
SOLUTION_TTL_DAYS=180

# --- tools -------------------------------------------------------------------
TOOLS_ENABLED=true
WEB_SEARCH_ENABLED=false
WEB_SEARCH_URL=
WEB_SEARCH_API_KEY=

# --- workers -----------------------------------------------------------------
WORKER_CONCURRENCY=2

# --- Brother (the personal assistant layer) ----------------------------------
# The client that holds the owner's knowledge pack, the agent the dashboard
# chat opens with, and where the pack lives on disk. Load it with:
#   docker compose exec ai-helper python -m app.cli bootstrap-brother
PERSONAL_CLIENT_ID=brother
PERSONAL_AGENT=brother
KNOWLEDGE_PACK_DIR=knowledge

# --- live connectors (read-only) ---------------------------------------------
# Market news: the public ForexFactory weekly calendar the v7 bot and the v18
# brain already read. Cached 600 s; a reading older than 3 h is UNKNOWN, never LOW.
MARKET_NEWS_ENABLED=true
MARKET_NEWS_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
MARKET_NEWS_REFRESH_SECONDS=600
MARKET_NEWS_MAX_AGE_HOURS=3
# Trading status: the Sniper-System platform's API v1 (portfolio, stats, open
# trades, last signals) with a USER API key made in the platform dashboard.
# Read-only by the platform's own Iron Rule 1. Inert until both are set.
TRADING_STATUS_ENABLED=true
TRADING_PLATFORM_URL=
TRADING_PLATFORM_API_KEY=

# --- docker compose only -----------------------------------------------------
POSTGRES_USER=aihelper
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=aihelper
N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
WEBUI_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
